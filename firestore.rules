rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the page link can read the study progress.
    // Only the plan owner can change it.
    match /{collection}/{docId} {
      allow read: if collection in ['blocks', 'topics', 'settings'];
      allow write: if collection in ['blocks', 'topics', 'settings']
                   && request.auth != null
                   && request.auth.token.email == 'assad.272q@gmail.com'
                   && request.auth.token.email_verified == true;
    }
  }
}
